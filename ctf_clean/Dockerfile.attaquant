FROM ubuntu:22.04
RUN apt-get update && apt-get install -y openssh-server gcc gdb python3 python3-pip nano binutils && rm -rf /var/lib/apt/lists/*
RUN pip3 install pwntools
RUN mkdir /var/run/sshd && ssh-keygen -A
RUN useradd -m -s /bin/bash analyste && echo "analyste:ENSEIRB2026" | chpasswd
RUN echo "AllowUsers analyste" >> /etc/ssh/sshd_config
COPY files/client_dns.c /home/analyste/
RUN gcc -fstack-protector-all -pie -fPIE -o /home/analyste/client_dns /home/analyste/client_dns.c
RUN rm /home/analyste/client_dns.c
COPY files/note_incident.txt /home/analyste/
RUN chown -R analyste:analyste /home/analyste
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
