<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration volontairement par défaut (pas de formatMsgNoLookups) :
     les lookups ${...} dans les messages loggés sont évalués, ce qui est
     la racine de CVE-2021-44228 sur Log4j 2.14.1. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
